@page "/vehicles"
@using System.Net.Http.Json
@inject HttpClient Http
@using GarageBlazor3.Client.DTOs

<h3>Parked Vehicles</h3>
<h4>Add Vehicle</h4>

<input @bind="newRegistrationNumber" placeholder="Registration number" />
<input @bind="newBrand" placeholder="Brand" />

<button @onclick="AddVehicle">Add Vehicle</button>

@if (vehicles is null)
{
    <p>Loading...</p>
}
else
{
    @foreach (var vehicle in vehicles)
    {
        <p>@vehicle.RegistrationNumber - @vehicle.Brand</p>
    }
}

@code {
    private List<VehicleDto>? vehicles;

    protected override async Task OnInitializedAsync()
    {
        vehicles = await Http.GetFromJsonAsync<List<VehicleDto>>("api/vehicles");
    }
    
    
    private string newRegistrationNumber = "";
    private string newBrand = "";

    private async Task AddVehicle()
    {
        var vehicle = new
        {
            RegistrationNumber = newRegistrationNumber,
            Brand = newBrand
        };

        var response = await Http.PostAsJsonAsync("api/vehicles", vehicle);

        if (response.IsSuccessStatusCode)
        {
            vehicles = await Http.GetFromJsonAsync<List<VehicleDto>>("api/vehicles");

            newRegistrationNumber = "";
            newBrand = "";
        }
    }
}