@page "/vehicles"

<h3>Parked Vehicles</h3>
<h4>Add Vehicle</h4>

<EditForm Model="@newVehicle" OnValidSubmit="AddVehicle">
    <DataAnnotationsValidator />

    <div>
        <label>Registration Number</label>
        <InputText @bind-Value="newVehicle.RegistrationNumber" />
        <ValidationMessage For="@(() => newVehicle.RegistrationNumber)" />
    </div>

    <div>
        <label>Brand</label>
        <InputText @bind-Value="newVehicle.Brand" />
        <ValidationMessage For="@(() => newVehicle.Brand)" />
    </div>
    <div>
        <label>Vehicle Type</label>

        <InputSelect @bind-Value="newVehicle.VehicleTypeId">
            <option value="0">Select vehicle type</option>

            @foreach (var type in vehicleTypes)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </InputSelect>

        <ValidationMessage For="@(() => newVehicle.VehicleTypeId)" />
    </div>

    <button type="submit">
        @(editingVehicleId is null ? "Add Vehicle" : "Save Changes")
    </button>
</EditForm>

@if (vehicles is null)
{
    <p>Loading...</p>
}
else
{
    @foreach (var vehicle in vehicles)
    {
        <p>@vehicle.RegistrationNumber - @vehicle.Brand</p>
        <button @onclick="() => DeleteVehicle(vehicle.Id)">Delete</button>
        <button @onclick="() => StartEditing(vehicle)">Edit</button>
    }
}